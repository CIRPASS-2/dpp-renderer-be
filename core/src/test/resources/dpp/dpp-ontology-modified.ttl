<http://dpp.taltech.ee/MODDPP#WaterPollution>
  a owl:Class ;
  rdfs:subClassOf <http://dpp.taltech.ee/MODDPP#EnvironmentalRelease> ;
  rdfs:label "Water pollution"@en .

<http://dpp.taltech.ee/MODDPP#PowerDraw>
  a owl:Class ;
  rdfs:subClassOf <http://dpp.taltech.ee/MODDPP#NaturalResourceUse> ;
  rdfs:label "Power draw"@en .

<http://dpp.taltech.ee/MODDPP#EnvironmentalRelease>
