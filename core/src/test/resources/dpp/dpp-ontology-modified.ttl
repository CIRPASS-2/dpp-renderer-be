  rdfs:label "Plastic emission"@en .

<http://dpp.taltech.ee/MODDPP#Item>
  a owl:Class ;
  rdfs:label "Item"@en ;
  skos:exactMatch "schema:Product" .

<http://dpp.taltech.ee/MODDPP#PhysicalDimension>
  a owl:Class ;
  rdfs:subClassOf <http://dpp.taltech.ee/MODDPP#MeasurableAttribute> ;
  rdfs:label "Physical dimension"@en .

<http://dpp.taltech.ee/MODDPP#PackagingRatio>
  a owl:Class ;
  rdfs:subClassOf <http://dpp.taltech.ee/MODDPP#MeasurableAttribute> ;
  rdfs:label "Packaging ratio"@en .

