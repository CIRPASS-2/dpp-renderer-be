# Packaging Details
ex:packaging-battery-003 a dpp:PackagingDetail ;
    dpp:packagingType "Heavy-duty wooden crate with foam inserts" ;
    dpp:packagingDate "2024-12-01T08:30:00Z"^^xsd:dateTime .