    dpp:dictionaryReference "https://example.com/dict/length" ;
    dpp:numericalValue "650.0"^^xsd:decimal ;
    dpp:tolerance "5.0"^^xsd:double ;
    dpp:hasMeasurementUnit si:millimeter .

ex:property-width-003 a dpp:Width ;
    dpp:dictionaryReference "https://example.com/dict/width" ;
    dpp:numericalValue "350.0"^^xsd:decimal ;
    dpp:tolerance "5.0"^^xsd:double ;
    dpp:hasMeasurementUnit si:millimeter .

ex:property-height-003 a dpp:Height ;
    dpp:dictionaryReference "https://example.com/dict/height" ;
    dpp:numericalValue "220.0"^^xsd:decimal ;
    dpp:tolerance "3.0"^^xsd:double ;
    dpp:hasMeasurementUnit si:millimeter .

ex:property-volume-003 a dpp:Volume ;
    dpp:dictionaryReference "https://example.com/dict/volume" ;
    dpp:numericalValue "50.05"^^xsd:decimal ;
    dpp:tolerance "1.0"^^xsd:double ;
