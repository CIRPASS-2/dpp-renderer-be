@prefix dpp: <http://dpp.taltech.ee/EUDPP#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix si: <https://si-digital-framework.org/SI#> .
@prefix ex: <http://example.com/> .

# Product: Industrial Battery
ex:product-battery-003 a dpp:Product ;
    dpp:uniqueProductID "urn:epc:id:sgtin:0614141.334567.003"^^xsd:anyURI ;
    dpp:productName "PowerMax Industrial Battery 500Ah" ;
    dpp:description "Batteria industriale al litio-ferro-fosfato per sistemi di accumulo energia" ;
    dpp:GTIN "8734567890123" ;
    dpp:commodityCode "8506500000" ;
    dpp:isEnergyRelated "true"^^xsd:boolean ;
    dpp:productImage "https://example.com/images/battery-003.jpg"^^xsd:anyURI .

# Product Group
ex:product-battery-003 dpp:hasProductGroup ex:classification-industrial-batteries .

# Actors
ex:product-battery-003 dpp:hasManufacturer ex:actor-manufacturer-theta .
ex:product-battery-003 dpp:hasEconomicOperator ex:actor-operator-iota .

# DPP
ex:product-battery-003 dpp:hasDPP ex:dpp-battery-003-dpp .

# Properties
ex:product-battery-003 dpp:hasProperty ex:property-weight-003 .
ex:product-battery-003 dpp:hasProperty ex:property-length-003 .
ex:product-battery-003 dpp:hasProperty ex:property-width-003 .
ex:product-battery-003 dpp:hasProperty ex:property-height-003 .
ex:product-battery-003 dpp:hasProperty ex:property-volume-003 .
ex:product-battery-003 dpp:hasProperty ex:property-carbon-footprint-003 .
ex:product-battery-003 dpp:hasProperty ex:property-material-footprint-003 .
ex:product-battery-003 dpp:hasProperty ex:property-recycling-rate-003 .
ex:product-battery-003 dpp:hasProperty ex:property-energy-consumption-003 .
ex:product-battery-003 dpp:hasProperty ex:property-durability-003 .
ex:product-battery-003 dpp:hasProperty ex:property-water-consumption-003 .
ex:product-battery-003 dpp:hasProperty ex:property-hazardous-waste-003 .

# Packaging
ex:product-battery-003 dpp:hasPackagingDetail ex:packaging-battery-003 .

# Substances of Concern
ex:product-battery-003 dpp:containsSubstanceOfConcern ex:soc-lithium .
ex:product-battery-003 dpp:containsSubstanceOfConcern ex:soc-cobalt .
ex:product-battery-003 dpp:containsSubstanceOfConcern ex:soc-nickel .

# Components
ex:product-battery-003 dpp:isComponentOf ex:product-energy-storage-system-001 .

# Classification Code
ex:classification-industrial-batteries a dpp:ClassificationCode ;
    dpp:codeSet "https://ec.europa.eu/growth/tools-databases/tbt/"^^xsd:anyURI ;
    dpp:codeValue "BATT-IND-LFP" .

# DPP
ex:dpp-battery-003-dpp a dpp:DPP ;
    dpp:uniqueDPPID "urn:uuid:c3d4e5f6-a7b8-6c7d-0e1f-2a3b4c5d6e7f"^^xsd:anyURI ;
    dpp:granularity "model" ;
    dpp:status "Active" ;
    dpp:schemaVersion "1.7.0" ;
    dpp:validFrom "2024-05-20T10:00:00Z"^^xsd:dateTimeStamp ;
    dpp:validUntil "2044-05-20T10:00:00Z"^^xsd:dateTimeStamp ;
    dpp:lastUpdate "2024-12-05T11:15:00Z"^^xsd:dateTimeStamp ;
    dpp:facilityID "FAC-CN-SZ-003" ;
    dpp:hasIssuer ex:actor-issuer-kappa ;
    dpp:hasBackUpCopyHost ex:actor-backup-host-002 ;
    dpp:appliesToProduct ex:product-battery-003 .

# Properties
ex:property-weight-003 a dpp:Weight ;
    dpp:dictionaryReference "https://example.com/dict/weight" ;
    dpp:numericalValue "45.8"^^xsd:decimal ;
    dpp:tolerance "0.5"^^xsd:double ;
    dpp:hasMeasurementUnit si:kilogram .

